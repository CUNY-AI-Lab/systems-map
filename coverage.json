{
  "$comment": "Which node claims which files. Every source file in every repo must be claimed exactly once; what nothing claims is reported as drift by scripts/fleet-measure.mjs. `priority` lets a specific claim beat a repo's catch-all.",
  "$externals": "Nodes with no claim here (cuny-login, workers-ai, openrouter, amazon-ses) are outside the Lab's code and measure zero by design.",

  "gateway-auth": { "repo": "cail-gateway", "paths": ["src/auth.ts"], "priority": 10 },
  "gateway-upstream": {
    "repo": "cail-gateway",
    "paths": ["src/upstream.ts", "src/provider-adapters.ts"],
    "priority": 10
  },
  "gateway-endpoint": { "repo": "cail-gateway", "paths": ["**"] },

  "doorway-signin": {
    "repo": "cail-doorway",
    "paths": ["src/oidc.ts", "src/identity.ts"],
    "priority": 10
  },
  "doorway-agent": {
    "repo": "cail-doorway",
    "paths": [
      "src/worker.ts",
      "src/admission-mcp.ts",
      "src/admission-oauth.ts",
      "src/admission-agent.ts"
    ],
    "priority": 10
  },
  "doorway-classes": {
    "repo": "cail-doorway",
    "paths": ["src/my-classes.ts", "src/owner-ui.ts"],
    "priority": 10
  },
  "doorway-front": { "repo": "cail-doorway", "paths": ["**"] },

  "admission-ledger": {
    "repo": "cail-tools-admission",
    "paths": ["src/registry.ts", "src/registry-schema-*.ts", "src/schema.ts", "src/schema-*.ts"],
    "priority": 10
  },
  "admission-email": { "repo": "cail-tools-admission", "paths": ["src/email.ts"], "priority": 10 },
  "admission-console": {
    "repo": "cail-tools-admission",
    "paths": ["src/admin-ui.ts"],
    "priority": 10
  },
  "admission-desk": { "repo": "cail-tools-admission", "paths": ["**"] },

  "model-access-registry": {
    "repo": "cail-tools-proxy",
    "paths": ["model-access-registry/**"],
    "priority": 10
  },
  "model-access-api": { "repo": "cail-tools-proxy", "paths": ["**"] },

  "chat-sandbox": {
    "repo": "cail-openwebui-deploy",
    "paths": ["image/**", "src/openwebui/**"],
    "priority": 10
  },
  "chat-rollout": { "repo": "cail-openwebui-deploy", "paths": ["**"] },

  "identity-library": { "repo": "cail-identity", "paths": ["**"] },

  "agent-studio-ui": { "repo": "agent-studio", "paths": ["frontend/**"], "priority": 10 },
  "agent-studio-service": { "repo": "agent-studio", "paths": ["**"] },

  "site-studio-ui": { "repo": "site-studio", "paths": ["packages/frontend/**"], "priority": 10 },
  "site-studio-service": { "repo": "site-studio", "paths": ["**"] },

  "sandbox-service": { "repo": "cail-sandbox-service", "paths": ["**"] }
}
